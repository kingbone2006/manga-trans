{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MangaTrans",
  "version": "0.1.0",
  "identifier": "com.kingbone2006.mangatrans",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "MangaTrans", "width": 1440, "height": 900, "minWidth": 1100, "minHeight": 700 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "windows": { "webviewInstallMode": { "type": "embedBootstrapper" } }
  }
}
